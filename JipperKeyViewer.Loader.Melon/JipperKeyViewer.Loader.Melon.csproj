<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>JipperKeyViewer.Loader</RootNamespace>
    <AssemblyName>JipperKeyViewer.Loader.Melon</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- 手写 Properties\AssemblyInfo.cs 保持为程序集特性与版本号的唯一来源
         （SetVersion.ps1 继续改它），屏蔽 SDK 的自动生成 /
         Hand-written Properties\AssemblyInfo.cs stays the single source of assembly
         attributes and versions (SetVersion.ps1 keeps patching it) — disable SDK generation. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- CI 直接从仓库根 bin\ 拷贝 DLL：不加 TFM 子目录 /
         CI copies DLLs straight from the repo-root bin\ — no TFM segment appended. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <!-- Release 产物统一落到仓库根 bin\（与主工程/另一入口汇于一处）；Debug 留在本工程。 /
         Release outputs land in the REPO-ROOT bin\ next to the other DLLs; Debug stays local. -->
    <OutputPath Condition="'$(Configuration)'=='Release'">..\bin\</OutputPath>
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
  </PropertyGroup>

  <!-- 允许在未安装 .NET Framework 4.8.1 Developer Pack 的机器上编译 /
       Lets the project compile without a local .NET Framework 4.8.1 Developer Pack. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 游戏与加载器引用 DLL，仅编译期使用，不拷入输出 /
       Game & loader reference DLLs, compile-time only — never copied to output. -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>..\libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\libs\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\libs\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\libs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MelonLoader">
      <HintPath>..\libs\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JipperKeyViewer\JipperKeyViewer.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
