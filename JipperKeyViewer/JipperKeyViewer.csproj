<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>JipperKeyViewer</RootNamespace>
    <AssemblyName>JipperKeyViewer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- 手写 Properties\AssemblyInfo.cs 保持为程序集特性与版本号的唯一来源
         （SetVersion.ps1 继续改它），屏蔽 SDK 的自动生成 /
         Hand-written Properties\AssemblyInfo.cs stays the single source of assembly
         attributes and versions (SetVersion.ps1 keeps patching it) — disable SDK generation. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- CI 直接从仓库根 bin\ 拷贝 DLL：不加 TFM 子目录 /
         CI copies DLLs straight from the repo-root bin\ — no TFM segment appended. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Release 产物统一落到仓库根的 bin\（三个工程的 DLL 汇于一处，直接可拷进游戏）；
         Debug 仍留在各自工程的 bin\，避免调试构建覆盖发布产物。 /
         Release outputs land in the REPO-ROOT bin\ (all three DLLs in one place, ready to
         drop into the game); Debug stays in each project's own bin\ so debug builds never
         clobber release artifacts. -->
    <OutputPath Condition="'$(Configuration)'=='Release'">..\bin\</OutputPath>
    <!-- Release 不生成 pdb：共享的仓库根 bin\ 只剩三个 DLL，打包/手拷都不会混入符号文件。
         / No pdb in Release: the shared repo-root bin\ holds exactly the three DLLs —
         symbols can never sneak into packaging or a manual copy. -->
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
  </PropertyGroup>

  <!-- 允许在未安装 .NET Framework 4.8.1 Developer Pack 的机器上编译 /
       Lets the project compile without a local .NET Framework 4.8.1 Developer Pack. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 游戏引用 DLL，仅编译期使用，不拷入输出 /
       Game reference DLLs, compile-time only — never copied to output. -->
  <ItemGroup>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\libs\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\libs\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\libs\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>..\libs\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>..\libs\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule">
      <HintPath>..\libs\UnityEngine.TextCoreTextEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\libs\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\libs\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\libs\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 视频按键节点：VideoPlayer 位于 VideoModule，游戏 Managed 目录自带该 DLL。 /
         Video key nodes: VideoPlayer lives in VideoModule, which the game ships in its own
         Managed directory. -->
    <Reference Include="UnityEngine.VideoModule">
      <HintPath>..\libs\UnityEngine.VideoModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 游戏自带 Newtonsoft：自定义布局的节点/图层组列表用它持久化（运行时 JsonUtility 会
         丢弃类数组字段）。游戏在 Managed 目录自带该 DLL，运行时可直接解析。 /
         The game ships Newtonsoft: the custom layout node/group lists persist through it
         (the runtime JsonUtility drops class-array fields). Resolvable at runtime from the
         game's own Managed directory. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\libs\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 运行时解压内嵌默认资源（DeflateStream）；Unity Mono 的 Managed 目录自带该程序集。 /
         Runtime decompression of the embedded default assets (DeflateStream); the assembly
         ships in Unity Mono's Managed directory. -->
    <Reference Include="System.IO.Compression">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 源码全在本工程树内（Main.cs + KeyViewer\**），SDK 默认通配自动纳入，
       无需链接式 Compile 条目。 /
       All sources live in this project tree (Main.cs + KeyViewer\**) — the SDK default
       glob picks them up; no link-style Compile entries needed. -->

  <ItemGroup>
    <!-- TGT compat shim: build order only (no compile reference); the resulting assembly is
         embedded below and Assembly.Load-ed at mod init. / TGT 兼容垫片：仅构建顺序（无编译引
         用）；产物在下方内嵌，mod 初始化时 Assembly.Load。 -->
    <ProjectReference Include="..\TgtCompat\KeyViewer.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="..\TgtCompat\bin\Release\KeyViewer.dll">
      <LogicalName>JipperKeyViewer.TgtCompat.KeyViewer.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 内嵌默认资源（DEFLATE，tools\Pack-EmbeddedAssets.ps1 生成，产物不进 git）：首次运行
       释放到 ModPath\assets\，已存在的文件不覆盖（用户自定义优先）。LogicalName 即运行时
       GetManifestResourceStream 用的资源名。 /
       Embedded default assets (DEFLATED, generated by tools\Pack-EmbeddedAssets.ps1, not
       tracked): extracted to ModPath\assets\ on first run; existing files are never
       overwritten (user replacements win). LogicalName is the resource name used by
       GetManifestResourceStream at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="embedded\KeyBackground.png.dfl" LogicalName="JipperKeyViewer.Assets.KeyBackground.png" />
    <EmbeddedResource Include="embedded\KeyOutline.png.dfl" LogicalName="JipperKeyViewer.Assets.KeyOutline.png" />
    <EmbeddedResource Include="embedded\GhostRain.png.dfl" LogicalName="JipperKeyViewer.Assets.GhostRain.png" />
    <EmbeddedResource Include="embedded\MAPLESTORY_OTF_BOLD.OTF.dfl" LogicalName="JipperKeyViewer.Assets.MAPLESTORY_OTF_BOLD.OTF" />
    <EmbeddedResource Include="embedded\cjkFonts-regular-normalized.otf.dfl" LogicalName="JipperKeyViewer.Assets.cjkFonts-regular-normalized.otf" />
  </ItemGroup>

</Project>
